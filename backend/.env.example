# ── Database (local Postgres for dev; Supabase Session-mode pooler for prod) ──
DATABASE_URL=postgresql://localhost:5432/hrms

# ── Auth ──
# Secret used to sign JWTs (admin + employee tokens) and signed file URLs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ── First-run admin bootstrap ──
# These seed the `admins` table ONCE on first startup (when the table is empty).
# After that, admins are managed in-app (Manage Admins tab) and these values are ignored for login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=your_super_secure_password_here

# ── File storage ──
# local (default): files on disk under backend/uploads/ — fine for dev, NOT durable on
#                  ephemeral hosts (e.g. Render free tier wipes disk on restart).
# supabase:        durable object storage. Set the three SUPABASE_* vars below and create a
#                  PRIVATE bucket named by SUPABASE_BUCKET in your Supabase project.
STORAGE_PROVIDER=local
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=<service-role-key>
# SUPABASE_BUCKET=onboarding-documents

# ── Server ──
PORT=5000

# Public base URL of this API (used to build file-download links). Defaults to http://localhost:PORT
API_BASE_URL=http://localhost:5000

# CORS — comma-separated allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
